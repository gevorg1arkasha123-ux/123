# ===== Обязательно =====
# Токен бота от @BotFather
BOT_TOKEN=
# Ваш домен (для docker compose) и полный адрес приложения
DOMAIN=bot.example.ru
PUBLIC_URL=https://bot.example.ru
# Ключ https://fal.ai/dashboard/keys — без него работает демо-режим (генерация имитируется)
FAL_KEY=
# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=

# ===== Оплата картой / СБП / T-Pay / SberPay (ЮKassa) =====
# Личный кабинет ЮKassa → Интеграция → Ключи API. Без них доступна только оплата Stars
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ===== Экономика =====
# 1 монета = COIN_RUB рублей
COIN_RUB=1
# Курс доллара (fal.ai берёт оплату в $)
USD_RUB=85
# Наценка к себестоимости: 2.5 = цена для клиента в 2.5 раза выше вашей себестоимости
MARKUP=2.5
# Сколько $ вы получаете за 1 звезду при выводе через Fragment
STAR_USD=0.013
# % монет пригласившему с каждой покупки приглашённого
REF_PERCENT=10
# Подарок новому пользователю (в монетах)
START_BONUS=50

# ===== Прочее =====
# Username поддержки без @ (появится кнопка в профиле)
SUPPORT_USERNAME=
PORT=3000
# 1 = открывать приложение в обычном браузере без Telegram (ТОЛЬКО для разработки)
DEV_AUTH=0

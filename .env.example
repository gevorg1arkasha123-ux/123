# Токен бота от @BotFather
BOT_TOKEN=
# Публичный HTTPS-адрес, где запущен сервер (его откроет Telegram как Mini App)
PUBLIC_URL=https://your-domain.com
PORT=3000
# Ключ https://fal.ai/dashboard/keys — без него работает демо-режим
FAL_KEY=
# Telegram ID админов через запятую (команда /give)
ADMIN_IDS=
# Сколько монет дарить новому пользователю
START_BONUS=50
# 1 = можно открыть приложение в обычном браузере без Telegram (только для разработки!)
DEV_AUTH=0

# ---- Экономика ----
# Сколько $ вы получаете за 1 звезду при выводе через Fragment (проверьте актуальный курс)
STAR_USD=0.013
# Наценка к себестоимости генерации на fal.ai (2.5 = цена в 2.5 раза выше себестоимости)
MARKUP=2.5
# % монет, который получает пригласивший с каждой покупки приглашённого
REF_PERCENT=10
